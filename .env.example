# Copy to .env (`make init` does it) and fill in.  .env is git-ignored.

# --- host -----------------------------------------------------------------------
TZ=Europe/London
# Your user/group id on the Docker host (`id -u` / `id -g`): files written by the
# containers in reports/, backups/ and data/librenms belong to this user.
PUID=1000
PGID=1000
# IP address of THIS Docker host as the switches see it.  The monitoring
# baseline points syslog (UDP 514) and SNMP traps (UDP 162) here.
MONITORING_HOST=192.0.2.10

# --- switch login (Ansible, discovery, Oxidized) ---------------------------------
# The default login.  Switches or sites with a different one are listed in
# ansible/inventory/credentials.yml (see credentials.yml.sample, or
# `make credentials-import CSV=passwords.csv`).
NET_USERNAME=netops
NET_PASSWORD=change-me
# Only if your account lands in user EXEC mode (prompt ends in '>').  Leave
# empty for privilege-15 / TACACS accounts that land at '#'.
NET_ENABLE_SECRET=

# --- SNMP: what the switches are configured with and LibreNMS polls with -------
SNMP_VERSION=v2c
SNMP_COMMUNITY=change-me-ro
# SNMPv3 instead (SNMP_VERSION=v3, passwords at least 8 characters):
SNMP_V3_USER=librenms
SNMP_V3_AUTH_PASS=
SNMP_V3_PRIV_PASS=

# --- LibreNMS ------------------------------------------------------------------------
LIBRENMS_DB_PASSWORD=change-me-too
LIBRENMS_HTTP_PORT=8000
# Address the plain-HTTP port listens on.  compose.yaml: 0.0.0.0 (any);
# compose.hosted.yaml: 127.0.0.1 (HTTPS only from outside).  Set it to override.
# LIBRENMS_HTTP_BIND=0.0.0.0
# false if the host has IPv6 disabled (the web UI then fails to start)
LIBRENMS_LISTEN_IPV6=true
# Used by `make librenms-admin` to create the first admin account.
LIBRENMS_ADMIN_USER=admin
LIBRENMS_ADMIN_PASSWORD=
# `make librenms-token` writes this for you.
LIBRENMS_API_TOKEN=

# --- Oxidized ------------------------------------------------------------------------
OXIDIZED_INTERVAL=3600
# The Oxidized web UI has no login.  127.0.0.1 = reachable only from this host
# (use an SSH tunnel); LibreNMS shows the configs anyway.
OXIDIZED_BIND=127.0.0.1

# --- optional: HTTPS for LibreNMS (compose.https.yaml) --------------------------------
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# LIBRENMS_HTTPS_HOST=librenms.example.net   # or an IP; several: comma-separated
# LIBRENMS_HTTPS_PORT=443

# --- optional ------------------------------------------------------------------------
# Pin image versions (defaults are tested together):
# LIBRENMS_VERSION=26.9.1.1
# OXIDIZED_VERSION=0.37.0
# Extra CA certificate for building the toolbox behind a TLS-inspecting proxy:
# EXTRA_CA_CERT=/etc/ssl/certs/corporate-ca.pem
