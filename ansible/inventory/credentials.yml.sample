---
# Logins that differ from the default in .env (NET_USERNAME, NET_PASSWORD,
# NET_ENABLE_SECRET).  Copy to credentials.yml in this directory:
#
#   cp ansible/inventory/credentials.yml.sample ansible/inventory/credentials.yml
#   chmod 600 ansible/inventory/credentials.yml
#
# credentials.yml is git-ignored.  Ansible, Oxidized (make sync) and
# discovery all use it.  Or create it from a spreadsheet:
#   make credentials-import CSV=passwords.csv
#
# Each key is one of:
#   - a switch, by its inventory name or its management IP address
#   - a site (inventory group), for every switch of that site
# Each entry sets any of username, password and enable.  What an entry leaves
# out comes from the next level: switch -> site -> .env.  `enable` is only
# needed when the account lands at the '>' prompt; without it, the login
# password is tried.
#
# Always put the values in single quotes ('...'); write a quote inside as ''.

hq-acc-01:
  password: 'Uniq#ue-pass-1'

hq-acc-02:
  password: 'an0ther:one'
  enable: 'its-enable-secret'

10.10.0.13:
  username: 'admin'
  password: 'keyed-by-ip'

branch1:
  username: 'branchadmin'
  password: 'used by every branch1 switch without its own entry'
